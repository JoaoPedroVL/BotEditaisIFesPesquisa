# Copie este arquivo para .env e preencha os valores.
# NUNCA versione o .env (ele já está no .gitignore).

# --- IA (NVIDIA NIM) ---
# Crie sua chave em https://build.nvidia.com/ -> "Get API Key"
NVIDIA_API_KEY=

# --- Telegram (canal de teste) ---
# Crie um bot com o @BotFather e pegue o chat_id com o @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- E-mail (alternativa simples, sem API de WhatsApp) ---
# Gmail: ative a verificação em duas etapas e crie uma "senha de app".
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_DESTINO=
EMAIL_REMETENTE=
# EMAIL_SSL=1 para porta 465; EMAIL_TLS=1 (padrão) para STARTTLS na 587.
EMAIL_SSL=0
EMAIL_TLS=1

# --- WhatsApp Cloud API oficial (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_DESTINO=
